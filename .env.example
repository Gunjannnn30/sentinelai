# SentinelAI — AI Governance & Security Platform
#
# Monorepo: FastAPI backend (`backend/`) + Next.js frontend (`frontend/`).
# Quickstart, architecture and operations: see README.md and docs/.
#
# Copy to `.env` and adjust. Names are prefixed `SENTINEL_` — the backend
# reads ONLY prefixed variables; unprefixed names are silently ignored.

# --- runtime -----------------------------------------------------------
SENTINEL_APP_ENV=development               # development | production | test
SENTINEL_LOG_LEVEL=INFO
SENTINEL_AUTH_SECRET=dev-only-local-secret-0f2c9a4e7b1d   # change for any shared env

# --- database ----------------------------------------------------------
# Local dev default (SQLite file under backend/data/). In docker-compose this
# is overridden to Postgres:
# SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:sentinel@db:5432/sentinel
SENTINEL_DATABASE_URL=sqlite:///./data/sentinelai.db
SENTINEL_DATABASE_ECHO=false

# --- cache (optional; empty = in-process rate limiting) ----------------
SENTINEL_REDIS_URL=

# --- auth & session ----------------------------------------------------
SENTINEL_SESSION_COOKIE_SECURE=false    # true behind TLS
SENTINEL_SESSION_TTL_HOURS=12
SENTINEL_LOGIN_RATE_LIMIT_PER_MINUTE=10
SENTINEL_RATE_LIMIT_PER_MINUTE=60
SENTINEL_ALLOW_DEV_LOGIN=true           # POST /api/v1/auth/dev-login; MUST be false in production

# --- gateway -----------------------------------------------------------
SENTINEL_GATEWAY_TIMEOUT_SECONDS=60
SENTINEL_GATEWAY_MAX_RETRIES=2
SENTINEL_MAX_REQUEST_BYTES=65536

# --- privacy & retention ----------------------------------------------
SENTINEL_STORE_PROMPT_CONTENT=false     # true stores masked prompt text on request records
SENTINEL_DEFAULT_RETENTION_DAYS=90
SENTINEL_AUDIT_RETENTION_DAYS=365

# --- seed --------------------------------------------------------------
SENTINEL_SEED_DEMO_DATA=true            # first-boot demo org/user when the DB is empty

# --- providers (leave empty to run the labeled mock provider only) -----
# Never commit real keys; set them in your shell / secret manager.
SENTINEL_OPENAI_API_KEY=
SENTINEL_OPENAI_BASE_URL=https://api.openai.com/v1
SENTINEL_ANTHROPIC_API_KEY=
SENTINEL_ANTHROPIC_BASE_URL=https://api.anthropic.com
SENTINEL_GEMINI_API_KEY=
SENTINEL_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
SENTINEL_OLLAMA_BASE_URL=http://localhost:11434

# --- frontend ----------------------------------------------------------
# Leave NEXT_PUBLIC_API_URL UNSET. The frontend then makes SAME-ORIGIN calls
# and `frontend/middleware.ts` proxies /api/*, /health, /ready and /metrics to
# the backend. That is the supported setup: cookies stay first-party and no
# CORS is required (the backend ships no CORS middleware by design).
#
# Setting it to an absolute origin makes the browser call that origin directly,
# which the browser blocks because the backend sends no CORS headers. Don't.
# NEXT_PUBLIC_API_URL=
#
# SENTINEL_API_ORIGIN is read by the frontend's middleware.ts, per request, on
# the SERVER only -- never exposed to the browser. Point it at wherever the
# backend actually listens. Compose sets http://backend:8000; a PaaS sets the
# backend's public HTTPS URL. It is never a build-time input.
# SENTINEL_API_ORIGIN=http://127.0.0.1:8123
