# SentinelAI frontend image.
# Build context = repository root (docker compose builds with context: .).
# Deliberately does NOT require Next `output: "standalone"` — runs `npm start`
# with the node_modules produced by the deps stage.
FROM node:20-alpine AS deps
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci || npm install

FROM node:20-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
# Same-origin proxy target for rewrites(): browser -> this Next server ->
# backend over the private network. Read at server start (not build time),
# so it can be overridden at runtime with -e SENTINEL_API_ORIGIN=...
# Do NOT bake a public API origin into the bundle: the backend ships no CORS
# middleware, so direct browser->API calls would be blocked.
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    SENTINEL_API_ORIGIN=http://backend:8000
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
EXPOSE 3000
# `next start` reads the platform-injected PORT itself (verified:
# `next start --help` -> "(default: 3000, env: PORT)") and already binds
# 0.0.0.0, so no shell wrapper or explicit -p/-H is needed. Compose and
# local `npm start` set no PORT and keep 3000.
CMD ["npm", "start"]
